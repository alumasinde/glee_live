# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=glee_demo
DB_USERNAME=alumasinde
DB_PASSWORD=21082108
DB_CHARSET=utf8mb4

# Redis
REDIS_ENABLED=false
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=5.0
REDIS_SESSION_ENABLED=false
REDIS_SESSION_PREFIX=session:

# Mail Configuration
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-mail-password
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Gatepass Management System
MAIL_INSECURE_TLS=false

# Security
SESSION_LIFETIME=120
SESSION_SECURE=false
CSRF_ENABLED=true
CSRF_TOKEN_LIFETIME=7200

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_DECAY=15
RATE_LIMIT_PASSWORD_RESET_MAX=3
RATE_LIMIT_PASSWORD_RESET_DECAY=60
RATE_LIMIT_API_MAX=60
RATE_LIMIT_API_DECAY=1

# Password Policy
PASSWORD_MIN_LENGTH=7
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=false

# Content Security Policy
CSP_ENABLED=true
CSP_REPORT_ONLY=false
CSP_REPORT_URI=

# HSTS (HTTPS only in production)
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

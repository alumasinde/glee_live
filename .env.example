# Application
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost
APP_NAME=GatePass

# Encryption keys for stored 2FA secrets (src/Modules/Auth/Services/MfaSecretCipher.php).
# Leave blank to run in derived-key mode, which is obfuscation only: with no key
# here, a dump of rows + source can decrypt every enrolled secret. Generate with:
#   php -r "echo bin2hex(random_bytes(32));"
# MFA_ENC_KEY wins over APP_KEY when both are set. Rotating either one logs every
# enrolled user out of 2FA (existing ciphertext stops decrypting).
APP_KEY=
MFA_ENC_KEY=
# Out-of-band pepper used only in derived-key mode. The shipped default
# ('change-me-mfa-pepper') is logged as a warning — replace it per install.
# Leave it commented out rather than blank: an empty value means "no pepper"
# and MfaSecretCipher refuses to encrypt with it.
#MFA_SECRET_PEPPER=

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=glee_live
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Redis
REDIS_ENABLED=false
REDIS_SCHEME=tcp
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT=5.0
REDIS_SESSION_ENABLED=false
REDIS_SESSION_PREFIX=session:

# Mail Configuration
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-mail-password
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=Gatepass Management System
MAIL_INSECURE_TLS=false

# Security
SESSION_LIFETIME=120
# Force the Secure cookie flag. HTTPS (including X-Forwarded-Proto) sets it
# automatically; this only adds it for proxies that do not forward the scheme.
SESSION_SECURE=false
# Comma-separated proxy IPs whose X-Forwarded-For / CF-Connecting-IP headers may
# be trusted for the client IP in the audit log. Empty = trust no proxy.
TRUSTED_PROXIES=
CSRF_ENABLED=true
CSRF_TOKEN_LIFETIME=7200

# Account lockout (per user row, on top of the IP+email rate limiter)
LOGIN_LOCKOUT_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Password Policy
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL=false

# Two-Factor Authentication (RFC 6238 TOTP)
TWO_FACTOR_ENABLED=true
TWO_FACTOR_ISSUER=GatePass
TWO_FACTOR_WINDOW=1
TWO_FACTOR_SECRET_BYTES=20
TWO_FACTOR_RECOVERY_CODES=8
TWO_FACTOR_CHALLENGE_TTL=300
TWO_FACTOR_SETUP_TTL=900
MFA_KDF_ITERATIONS=100000
# Keep MFA_REQUIRE_PERMISSION=false until an mfa.manage permission exists in
# config/permissions.php and a grants migration.
MFA_REQUIRE_PERMISSION=false
MFA_PERMISSION=mfa.manage

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_DECAY=15
RATE_LIMIT_PASSWORD_RESET_MAX=3
RATE_LIMIT_PASSWORD_RESET_DECAY=60
RATE_LIMIT_API_MAX=60
RATE_LIMIT_API_DECAY=1
# 2FA challenge and gate scanning. Keys must contain no colon and no dash.
RATE_LIMIT_MFA_MAX=10
RATE_LIMIT_MFA_DECAY=10
RATE_LIMIT_SCAN_MAX=120
RATE_LIMIT_SCAN_DECAY=1

# Content Security Policy
CSP_ENABLED=true
CSP_REPORT_ONLY=false
CSP_REPORT_URI=

# HSTS (HTTPS only in production)
HSTS_ENABLED=false
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true

# Queue / scheduled jobs (bin/notify-outbox, bin/approval-escalation, bin/audit-retention)
JOBS_REMINDER_HOURS=24
JOBS_ADMIN_HOURS=48
JOBS_MAX_ESCALATIONS=3
JOBS_ESCALATION_LIMIT=200
JOBS_EMAIL_RETRY_LIMIT=50
JOBS_DISPATCH_LIMIT=100
JOBS_AUDIT_RETENTION_DAYS=365
JOBS_NOTIFY_RETENTION_DAYS=90
JOBS_RETENTION_CHUNK=1000
JOBS_RETENTION_MESSAGE_MARKER=anonymised (retention policy)
